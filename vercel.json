{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "src/app/api/v1/conversations/[conversationId]/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/v1/conversations/[conversationId]/research-run/start/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/v1/conversations/[conversationId]/market-synthesis/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/v1/conversations/[conversationId]/company-search/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/v1/conversations/[conversationId]/people-discovery/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/v1/conversations/[conversationId]/templates/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/v1/conversations/[conversationId]/messages/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/v1/conversations/[conversationId]/autopilot/start/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/v1/conversations/[conversationId]/autopilot/status/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/v1/conversations/[conversationId]/autopilot/step/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/internal/jobs/autopilot/route.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
