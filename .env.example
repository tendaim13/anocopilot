# Ano owns its own Supabase project. Do not point these variables at Mercury.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# One-time schema administration only. This is never read by browser or app
# runtime code. It must point at Ano's database, never Mercury's.
SUPABASE_DB_URL=
# Optional but recommended for strict TLS verification. Download the root
# certificate from Supabase: Database Settings > SSL Configuration, save it
# outside source control, then set its absolute local path here.
SUPABASE_DB_SSL_CA_PATH=
ANO_DATABASE_LABEL=ano

# Local development only. This enables the display-only browser shell when
# Ano has not yet been connected to its own Supabase project. It never enables
# a generated brief or any simulated research result.
ANO_ALLOW_DEMO_MODE=true

# Reasoning LLM provider: disabled | gemini | ollama | bedrock.
# Keep Bedrock settings below so switching back takes changing ANO_AGENT_MODE only.
ANO_AGENT_MODE=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Google AI Studio (Gemini Developer API) - token-conserving Flash-Lite default
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional: override thinking budget (0 for Gemini 2.5) or level (minimal for Gemini 3.x)
# GEMINI_THINKING_BUDGET=0
# GEMINI_THINKING_LEVEL=minimal
AWS_REGION=
BEDROCK_MODEL_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Use one AWS SDK credential source. For direct local development, add a
# dedicated least-privilege IAM access-key pair here. Use AWS_SESSION_TOKEN
# only when the credentials are temporary. An AWS profile/SSO configuration or
# a deployment IAM role can be used instead, in which case leave these blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# Retained only to read historic Tavily receipts. Ano does not create new
# Tavily runs and this value is not needed for the SearXNG path.
TAVILY_API_KEY=

# Phase B private public-evidence search. Both values are server-only; never
# prefix them with NEXT_PUBLIC_ or expose them in an API response. The gateway
# must be an authenticated HTTPS endpoint in front of the private SearXNG
# container. Ano still needs an explicit approval for every research run.
SEARXNG_BASE_URL=
SEARXNG_GATEWAY_TOKEN=
