# Ano owns its own Supabase project. Do not point these variables at Mercury.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# One-time schema administration only. This is never read by browser or app
# runtime code. It must point at Ano's database, never Mercury's.
SUPABASE_DB_URL=
# Optional but recommended for strict TLS verification. Download the root
# certificate from Supabase: Database Settings > SSL Configuration, save it
# outside source control, then set its absolute local path here.
SUPABASE_DB_SSL_CA_PATH=
ANO_DATABASE_LABEL=ano

# Local development only. This enables the display-only browser shell when
# Ano has not yet been connected to its own Supabase project. It never enables
# a generated brief or any simulated research result.
ANO_ALLOW_DEMO_MODE=true

# Bedrock is server-only. It uses an AWS IAM identity, not an API key.
# Keep ANO_AGENT_MODE=disabled until the model, guardrail, and credential
# source below are configured. Do not prefix any of these values with
# NEXT_PUBLIC_ and never commit their values.
ANO_AGENT_MODE=disabled
AWS_REGION=
BEDROCK_MODEL_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Use one AWS SDK credential source. For direct local development, add a
# dedicated least-privilege IAM access-key pair here. Use AWS_SESSION_TOKEN
# only when the credentials are temporary. An AWS profile/SSO configuration or
# a deployment IAM role can be used instead, in which case leave these blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
