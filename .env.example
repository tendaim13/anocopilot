# Ano owns its own Supabase project. Do not point these variables at Mercury.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# One-time schema administration only. This is never read by browser or app
# runtime code. It must point at Ano's database, never Mercury's.
SUPABASE_DB_URL=
ANO_DATABASE_LABEL=ano

# Local development only. This enables the clearly-labelled browser demo when
# Ano has not yet been connected to its own Supabase project.
ANO_ALLOW_DEMO_MODE=true
