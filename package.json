{
  "name": "ano-copilot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "check:migrations": "node scripts/check-migrations-registered.mjs",
    "test:phase4a": "tsx --test tests/phase4a-runtime.test.ts",
    "test:phase4b": "tsx --test tests/phase4b-bedrock-runtime.test.ts",
    "test:standalone": "tsx --test tests/standalone-brief-runtime.test.ts",
    "test:icp": "tsx --test tests/icp-profile-runtime.test.ts",
    "test:market": "tsx --test tests/market-hypothesis-runtime.test.ts",
    "test:market-phase-b": "tsx --test tests/market-discovery-phase-b.test.ts",
    "test:market-phase-c": "node --conditions=react-server --import tsx --test tests/prospeo-company-discovery.test.ts",
    "test:research-phase-a": "node --conditions=react-server --import tsx --test tests/research-conversation-graph.test.ts",
    "test:research-phase-b": "node --conditions=react-server --import tsx --test tests/evidence-research-graph.test.ts",
    "test:research-phase-c": "node --conditions=react-server --import tsx --test tests/market-synthesis-phase-c.test.ts",
    "test:research-planning": "node --conditions=react-server --import tsx --test tests/research-planning-fallback.test.ts",
    "test:research-deep": "node --conditions=react-server --import tsx --test tests/iterative-deep-research.test.ts",
    "test:tavily-contract": "node --conditions=react-server --import tsx --test tests/tavily-extract-contract.test.ts",
    "test:searxng-contract": "node --conditions=react-server --import tsx --test tests/searxng-provider.test.ts tests/evidence-source-retriever.test.ts",
    "smoke:research-phase-a": "node --env-file=.env.local --conditions=react-server --import tsx scripts/smoke-research-phase-a.ts",
    "db:apply": "node --env-file=.env.local scripts/apply-ano-schema.mjs",
    "db:apply:ci": "node scripts/apply-ano-schema.mjs",
    "db:status": "node --env-file=.env.local scripts/check-ano-schema.mjs",
    "db:status:ci": "node scripts/check-ano-schema.mjs",
    "usage:report": "node --env-file=.env.local scripts/report-api-usage.mjs",
    "usage:report:ci": "node scripts/report-api-usage.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1154.0",
    "@langchain/aws": "^1.5.0",
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@material/web": "2.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "cheerio": "^1.2.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pg": "^8.16.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
