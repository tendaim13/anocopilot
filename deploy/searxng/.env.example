# DNS must point this hostname to the EC2 public IP before Caddy is started.
SEARXNG_DOMAIN=search.example.com
ACME_EMAIL=operations@example.com

# Generate each secret only on the EC2 host, for example:
#   openssl rand -hex 32
SEARXNG_SECRET=
SEARXNG_GATEWAY_TOKEN=

# Strictly server-only Brave Search API credential injected into the private
# SearXNG container at boot into tmpfs. Never commit, expose to Caddy, add to
# Vercel client bundles, or prefix with NEXT_PUBLIC_.
BRAVE_API_KEY=

# Replace every placeholder with the immutable digest obtained during deployment.
# Do not use `latest` in the live .env file.
SEARXNG_IMAGE=searxng/searxng@sha256:REPLACE_WITH_RESOLVED_DIGEST
CADDY_IMAGE=caddy@sha256:REPLACE_WITH_RESOLVED_DIGEST
VALKEY_IMAGE=valkey/valkey@sha256:REPLACE_WITH_RESOLVED_DIGEST
